{
  "$description": "Axiom seed token vocabulary for the Button and Select slices",
  "color": {
    "$type": "color",
    "primitive": {
      "blue": {
        "500": { "$value": "#2563eb" },
        "600": { "$value": "#1d4ed8" },
        "700": { "$value": "#1e40af" }
      },
      "neutral": {
        "0": { "$value": "#ffffff" },
        "50": { "$value": "#f8fafc" },
        "100": { "$value": "#f1f5f9" },
        "200": { "$value": "#e2e8f0" },
        "400": { "$value": "#94a3b8" },
        "600": { "$value": "#475569" },
        "900": { "$value": "#0f172a" }
      },
      "red": {
        "50": { "$value": "#fef2f2" },
        "600": { "$value": "#dc2626" },
        "700": { "$value": "#b91c1c" }
      }
    },
    "action": {
      "background": {
        "default": { "$value": "{color.primitive.blue.600}" },
        "hover": { "$value": "{color.primitive.blue.700}" },
        "pressed": { "$value": "{color.primitive.blue.500}" },
        "disabled": { "$value": "{color.primitive.neutral.200}" }
      },
      "foreground": {
        "default": { "$value": "{color.primitive.neutral.0}" },
        "disabled": { "$value": "{color.primitive.neutral.600}" }
      }
    },
    "surface": {
      "default": { "$value": "{color.primitive.neutral.0}" },
      "subtle": { "$value": "{color.primitive.neutral.50}" },
      "hover": { "$value": "{color.primitive.neutral.100}" },
      "selected": { "$value": "{color.primitive.blue.600}" },
      "danger": { "$value": "{color.primitive.red.50}" }
    },
    "text": {
      "default": { "$value": "{color.primitive.neutral.900}" },
      "muted": { "$value": "{color.primitive.neutral.600}" },
      "inverse": { "$value": "{color.primitive.neutral.0}" },
      "danger": { "$value": "{color.primitive.red.700}" }
    },
    "border": {
      "default": { "$value": "{color.primitive.neutral.200}" },
      "focus": { "$value": "{color.primitive.blue.500}" },
      "danger": { "$value": "{color.primitive.red.600}" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": { "value": 32, "unit": "px" } },
      "md": { "$value": { "value": 40, "unit": "px" } },
      "lg": { "$value": { "value": 48, "unit": "px" } }
    },
    "icon": {
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 20, "unit": "px" } }
    },
    "popover": {
      "min": { "$value": { "value": 200, "unit": "px" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "default": { "$value": { "value": 1, "unit": "px" } },
      "focus": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } }
    },
    "lineHeight": {
      "$type": "number",
      "sm": { "$value": 1.25 },
      "md": { "$value": 1.5 }
    }
  }
}
