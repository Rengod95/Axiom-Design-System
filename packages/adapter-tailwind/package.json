{
  "name": "@axiom/adapter-tailwind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": "./src/generated/styles.css"
  },
  "files": ["dist", "src/generated"],
  "scripts": {
    "build": "tsc -b",
    "generate": "node --import tsx scripts/generate.ts"
  },
  "dependencies": {
    "@axiom/appearance-schema": "workspace:*",
    "@axiom/recipe-engine": "workspace:*",
    "@axiom/tokens": "workspace:*"
  },
  "devDependencies": {
    "@axiom/recipes": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.3 <5"
  }
}
