      "css": ".ds-button-subtle{min-height:32px;padding:5px 9px;border:1px solid transparent;border-radius:var(--radius-control,8px);font:500 12px/1.4 var(--font-ui,Geist,sans-serif);cursor:pointer}.ds-button-subtle:focus-visible{outline:2px solid var(--focus,#43830c);outline-offset:3px}.ds-button-subtle:disabled{opacity:.46;cursor:not-allowed}.ds-button-subtle{background:transparent;color:var(--ink-secondary,#595959)}.ds-button-subtle:hover{background:var(--surface-hover)}.ds-button-subtle:active{background:var(--surface-active)}"
