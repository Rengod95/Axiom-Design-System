      "css": ".ds-nav{height:36px;padding:7px 10px;border:0;border-radius:999px;background:transparent;color:var(--ink-secondary,#595959);font:550 12px var(--font-ui,Geist,sans-serif)}.ds-nav:hover{background:var(--surface-hover,#e8e8e8)}.ds-nav[aria-pressed=true]{background:var(--brand,#a3ff47);color:#172108}.ds-nav:focus-visible{outline:2px solid var(--focus,#43830c);outline-offset:3px}"
