      "description": "Compact managed value field.",
      "html": "<input class=\"ds-input\" aria-label=\"Token name\" value=\"color.brand.200\">",
      "css": ".ds-input{min-height:32px;padding:5px 8px;border:1px solid transparent;border-radius:var(--radius-control,12px);background:var(--surface-subtle,#f2f2f2);color:var(--ink,#202020);font:400 12px/1.4 var(--font-ui,Geist,sans-serif)}.ds-input:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:1px}.ds-input[aria-invalid=true]{border-color:var(--negative,#b23242)}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact fluorescent active workspace.",
      "html": "<nav aria-label=\"Workspace\"><button class=\"ds-nav\" aria-pressed=\"true\">Foundation</button><button class=\"ds-nav\" aria-pressed=\"false\">Library</button></nav>",
      "css": ".ds-nav{height:36px;padding:7px 10px;border:0;border-radius:var(--radius-control,12px);background:transparent;color:var(--ink-secondary,#595959);font:550 12px var(--font-ui,Geist,sans-serif)}.ds-nav:hover{background:var(--surface-hover,#e8e8e8)}.ds-nav[aria-pressed=true]{background:var(--brand,#8dfc52);color:var(--on-accent,#152009)}.ds-nav:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}"
    },
    {
      "name": "Filled choice",
      "kind": "chip",
      "refersTo": "choice-chip",
      "description": "One neutral selected surface.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">Specimens</button>",
      "css": ".ds-chip{min-height:28px;padding:3px 8px;border:0;border-radius:8px;font:500 12px var(--font-ui,Geist,sans-serif);background:var(--surface-subtle,#f2f2f2);color:var(--ink,#202020)}.ds-chip:hover,.ds-chip[aria-pressed=true]{background:var(--surface-active,#dedede)}.ds-chip:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}"
    },
    {
      "name": "Glass dropdown",
      "kind": "custom",
      "refersTo": "select",
      "description": "Frosted listbox material; full keyboard behavior lives in Select.",
      "html": "<div class=\"ds-menu\" role=\"listbox\" aria-label=\"Token type\"><div class=\"ds-option\" role=\"option\" aria-selected=\"true\">Color</div><div class=\"ds-option\" role=\"option\" aria-selected=\"false\">Dimension</div></div>",
      "css": ".ds-menu{width:160px;padding:4px;border:1px solid var(--line,#d2d2d2);border-radius:var(--radius-panel,16px);background:var(--glass-raised,rgb(250 250 250 /80%));color:var(--ink,#202020);backdrop-filter:blur(24px) saturate(1.08);box-shadow:0 12px 32px rgb(0 0 0 /.24);font:450 12px/18px var(--font-ui,Geist,sans-serif)}.ds-option{min-height:32px;padding:6px 8px;border-radius:8px}.ds-option:hover{background:var(--surface-hover,#e8e8e8)}.ds-option:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}"
    },
    {
      "name": "Domain blueprint",
      "kind": "card",
      "refersTo": "domain-blueprint",
      "description": "One crisp material drawing per domain. The drawing is navigation context, not a new token value.",
      "html": "<button class=\"ds-domain\" aria-label=\"Open Radius domain\"><svg viewBox=\"0 0 280 154\" aria-hidden=\"true\"><path d=\"M30 77H250M140 14V140\" class=\"ds-guide\"/><path d=\"M64 128V82Q64 28 118 28H218\"/><path d=\"M64 82H118V28M118 82L80 44\" class=\"ds-guide\"/><circle cx=\"118\" cy=\"82\" r=\"54\" class=\"ds-guide\"/><circle cx=\"118\" cy=\"82\" r=\"3\"/></svg><strong>Radius</strong><span>Corner scales and roles</span></button>",
      "css": ".ds-domain{display:grid;width:280px;gap:6px;padding:12px;border:1px solid var(--line,#d2d2d2);border-radius:var(--radius-control,12px);background:color-mix(in srgb,var(--surface,#fafafa) 45%,transparent);color:var(--ink,#202020);text-align:left;font:400 12px/18px var(--font-ui,Geist,sans-serif);cursor:pointer}.ds-domain svg{width:100%;fill:none;stroke:var(--ink-secondary,#595959);stroke-width:1;stroke-linecap:round;stroke-linejoin:round}.ds-guide{opacity:.35;stroke-dasharray:2 4}.ds-domain strong{font-weight:500}.ds-domain span{font-size:11px;color:var(--ink-secondary,#595959)}.ds-domain:hover{background:var(--surface-hover,#e8e8e8)}.ds-domain:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}"
    },
    {
      "name": "Precision slider",
      "kind": "custom",
      "refersTo": "slider",
      "description": "Styling specimen for range and precision entry; the production component couples the controls and preserves lexical input and IME.",
      "html": "<div class=\"ds-slider\"><input class=\"ds-range\" type=\"range\" min=\"0\" max=\"100\" value=\"64\" aria-label=\"Opacity slider\"><label class=\"ds-precision\"><input value=\"64\" inputmode=\"decimal\" aria-label=\"Opacity\"><span>%</span></label></div>",
      "css": ".ds-slider{display:grid;grid-template-columns:minmax(0,1fr) 60px;gap:8px;padding:4px 8px;width:280px;align-items:center;background:var(--surface-subtle,#f2f2f2);border-radius:var(--radius-control,12px);color:var(--ink,#202020);font:400 12px/18px var(--font-ui,Geist,sans-serif)}.ds-range{appearance:none;width:100%;height:28px;background:transparent;margin:0}.ds-range::-webkit-slider-runnable-track{height:3px;border-radius:999px;background:linear-gradient(90deg,#656565 64%,#cdcdcd 64%)}.ds-range::-webkit-slider-thumb{appearance:none;width:16px;height:16px;margin-top:-6.5px;border:1px solid #c7c7c7;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgb(0 0 0 /16%)}.ds-range:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}.ds-precision{display:flex;gap:3px;align-items:center;border-left:1px solid var(--line,#d2d2d2);padding-left:7px}.ds-precision input{width:100%;min-width:0;height:28px;border:0;background:transparent;color:inherit;font:inherit;text-align:right}.ds-precision input:focus-visible{outline:2px solid var(--focus,#348023)}.ds-precision span{font-size:10px;color:var(--ink-secondary,#595959)}"
    }
  ],
  "narrative": {
    "northStar": "Blueprint workbench",
    "overview": "Axiom UI combines precise material drawings with compact neutral glass. Geist, thin construction lines and optical corners give English and Korean authoring a consistent rhythm. Fluorescent green identifies action and the flow of real references; authored materials remain the visual subject.\n\nStructural planes are translucent and flat. The sidebar, inspector, headers and footer share neutral diffusion without inset highlights or bevels. Individual domains have one recognizable blueprint drawing. Inside a domain, the material determines the presentation: a shade row, a shared ruler, a stroke, an elevated object or an actual typographic specimen.",
    "keyCharacteristics": [
      "Achromatic glass with a fluorescent action and dependency accent.",
      "Compact controls with optical 8/12/16px corners.",
      "Primitive scales and semantic roles with real source connections.",
      "Purpose-specific specimens instead of repeated generic cards.",
      "Adjustable navigation, contextual help and restrained scroll indicators."
    ],
    "rules": [
      {
        "name": "Independent Values",
        "body": "Studio appearance never rewrites authored token values or saved appearance preferences.",
        "section": "colors"
      },
      {
        "name": "One Selected Surface",
        "body": "Use one neutral fill for selected material and segmented choices; preserve a distinct keyboard focus outline.",
        "section": "colors"
      },
