  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accent action with the implemented light/dark foreground and hover pair.",
      "html": "<button type=\"button\" class=\"ds-button ds-primary\">Apply changes</button>",
      "css": ".ds-button{min-height:32px;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:6px 11px;border:1px solid transparent;border-radius:7px;font-family:var(--font-ui,SUIT,Geist,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:12px;font-weight:600;line-height:18px;letter-spacing:0;white-space:nowrap;cursor:pointer;transition:background var(--motion-fast,160ms) var(--motion-ease,cubic-bezier(.16,1,.3,1)),color var(--motion-fast,160ms) var(--motion-ease,cubic-bezier(.16,1,.3,1))}.ds-button:focus-visible{outline:2px solid var(--focus,#6b5ce6);outline-offset:3px}.ds-button:disabled{cursor:not-allowed;opacity:.46}.ds-primary{background:var(--accent,#5b50d6);color:#fff}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#4c40c2)}:host-context([data-theme=dark]) .ds-primary{color:#16131e}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;animation:none}}"
    },
    {
