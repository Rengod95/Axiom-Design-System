  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action.",
      "html": "<button class=\"ds-button-primary\">Primary action</button>",
      "css": ".ds-button-primary{min-height:32px;padding:5px 9px;border:1px solid transparent;border-radius:var(--radius-control,12px);font:500 12px/1.4 var(--font-ui,Geist,sans-serif);cursor:pointer}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}.ds-button-primary:disabled{opacity:.46;cursor:not-allowed}.ds-button-primary{background:var(--accent,#8dfc52);color:var(--on-accent,#152009)}.ds-button-primary:hover{background:var(--accent-hover)}.ds-button-primary:active{background:var(--accent-hover)}.ds-button-primary{box-shadow:0 3px 12px color-mix(in srgb,var(--brand,#8dfc52) 9%,transparent)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared secondary action.",
      "html": "<button class=\"ds-button-secondary\">Secondary action</button>",
      "css": ".ds-button-secondary{min-height:32px;padding:5px 9px;border:1px solid transparent;border-radius:var(--radius-control,12px);font:500 12px/1.4 var(--font-ui,Geist,sans-serif);cursor:pointer}.ds-button-secondary:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}.ds-button-secondary:disabled{opacity:.46;cursor:not-allowed}.ds-button-secondary{background:var(--surface-subtle,#f2f2f2);color:var(--ink,#202020)}.ds-button-secondary:hover{background:var(--surface-hover)}.ds-button-secondary:active{background:var(--surface-active)}"
    },
    {
      "name": "Subtle button",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "Shared subtle action.",
      "html": "<button class=\"ds-button-subtle\">Subtle action</button>",
      "css": ".ds-button-subtle{min-height:32px;padding:5px 9px;border:1px solid transparent;border-radius:var(--radius-control,12px);font:500 12px/1.4 var(--font-ui,Geist,sans-serif);cursor:pointer}.ds-button-subtle:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}.ds-button-subtle:disabled{opacity:.46;cursor:not-allowed}.ds-button-subtle{background:transparent;color:var(--ink-secondary,#595959)}.ds-button-subtle:hover{background:var(--surface-hover)}.ds-button-subtle:active{background:var(--surface-active)}"
    },
    {
      "name": "Danger button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Shared danger action.",
      "html": "<button class=\"ds-button-danger\">Danger action</button>",
      "css": ".ds-button-danger{min-height:32px;padding:5px 9px;border:1px solid transparent;border-radius:var(--radius-control,12px);font:500 12px/1.4 var(--font-ui,Geist,sans-serif);cursor:pointer}.ds-button-danger:focus-visible{outline:2px solid var(--focus,#348023);outline-offset:3px}.ds-button-danger:disabled{opacity:.46;cursor:not-allowed}.ds-button-danger{background:var(--negative-soft,#fff0f1);color:var(--negative,#b23242)}.ds-button-danger:active{background:var(--surface-active)}"
