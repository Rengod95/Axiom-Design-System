      "html": "<div class=\"ds-field\"><label for=\"ds-token-name\">Token name</label><input id=\"ds-token-name\" value=\"brand.accent\" aria-describedby=\"ds-token-hint\"/><small id=\"ds-token-hint\">A stable name for this token.</small></div>",
