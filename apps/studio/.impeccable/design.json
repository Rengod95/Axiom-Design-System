    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action.",
      "html": "<button class=\"ds-button-primary\">Primary action</button>",
      "css": ".ds-button-primary{min-height:32px;padding:5px 9px;border:1px solid transparent;border-radius:var(--radius-control,8px);font:500 12px/1.4 var(--font-ui,Geist,sans-serif);cursor:pointer}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#43830c);outline-offset:3px}.ds-button-primary:disabled{opacity:.46;cursor:not-allowed}.ds-button-primary{background:var(--accent,#a3ff47);color:var(--on-accent,#152009)}.ds-button-primary:hover{background:var(--accent-hover)}.ds-button-primary:active{background:var(--accent-hover)}.ds-button-primary{box-shadow:0 3px 12px color-mix(in srgb,var(--brand,#a3ff47) 9%,transparent),inset 0 1px 0 rgb(255 255 255 / 35%)}"
    },
    {
      "name": "Secondary button",
