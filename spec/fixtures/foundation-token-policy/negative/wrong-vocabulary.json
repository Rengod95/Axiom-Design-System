{
  "schemaVersion": "0.1",
  "semanticVocabularyRegistry": "legacy-vocabulary",
  "rootFontSizePx": 16,
  "authoredDimensionUnits": ["px", "rem"],
  "derivedCssUnits": ["em"],
  "forbiddenPrimitiveSegments": ["disabled"],
  "colorScales": [
    { "palette": "neutral", "shades": [0, 1000] },
    { "palette": "brand", "shades": [50, 950] }
  ],
  "spaceScale": {
    "baseUnitPx": 4,
    "steps": [
      { "name": "0", "valuePx": 0 },
      { "name": "1", "valuePx": 4 },
      { "name": "2", "valuePx": 8 },
      { "name": "3", "valuePx": 12 },
      { "name": "4", "valuePx": 16 },
      { "name": "5", "valuePx": 20 },
      { "name": "6", "valuePx": 24 },
      { "name": "8", "valuePx": 32 }
    ]
  },
  "dimensionDomainUnits": {
    "space": ["px", "rem"]
  },
  "typography": {
    "bodyBasePx": 16,
    "bodyMinimumPx": 13,
    "fontSizePx": [13, 14, 15, 16, 18, 20, 24, 28, 32, 40],
    "weightVariants": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "families": [
      { "path": "heading.h1", "sizePx": 40 },
      { "path": "heading.h2", "sizePx": 32 },
      { "path": "heading.h3", "sizePx": 28 },
      { "path": "heading.h4", "sizePx": 24 },
      { "path": "heading.h5", "sizePx": 20 },
      { "path": "heading.h6", "sizePx": 18 },
      { "path": "body.xsmall", "sizePx": 13 },
      { "path": "body.small", "sizePx": 14 },
      { "path": "body.compact", "sizePx": 15 },
      { "path": "body.base", "sizePx": 16 }
    ]
  },
  "contrastPairs": [
    {
      "foreground": "color.semantic.text.primary",
      "background": "color.semantic.surface.canvas",
      "minimumRatio": 4.5
    }
  ]
}
