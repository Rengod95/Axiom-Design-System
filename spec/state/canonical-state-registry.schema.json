{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/state/canonical-state-registry/0.2",
  "title": "Axiom Canonical State Registry",
  "type": "object",
  "required": ["schemaVersion", "states"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "required": [
        "id",
        "axis",
        "valueType",
        "applicableComponents",
        "usage"
      ],
      "properties": {
        "id": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "axis": { "enum": ["lifecycle", "state"] },
        "valueType": { "enum": ["boolean", "enum"] },
        "values": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" }
        },
        "applicableComponents": {
          "description": "Exact Recipe IDs apply component-wide; exact Recipe.Slot IDs apply only to that Slot.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" }
        },
        "usage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["appearance", "behavior", "motion"] },
          "contains": { "enum": ["appearance", "motion"] }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "valueType": { "const": "enum" } },
            "required": ["valueType"]
          },
          "then": {
            "properties": { "values": true },
            "required": ["values"]
          },
          "else": { "properties": { "values": false } }
        },
        {
          "if": {
            "properties": { "axis": { "const": "lifecycle" } },
            "required": ["axis"]
          },
          "then": {
            "properties": { "valueType": { "const": "boolean" } }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
