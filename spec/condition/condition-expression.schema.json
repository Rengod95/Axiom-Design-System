{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/condition/expression/0.1",
  "title": "Axiom Condition Expression",
  "type": "object",
  "required": ["all"],
  "properties": {
    "all": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
          {
            "type": "object",
            "required": ["any"],
            "properties": {
              "any": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" }
              }
            },
            "unevaluatedProperties": false
          }
        ]
      }
    }
  },
  "unevaluatedProperties": false
}
