{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/css/appearance-ir/0.1",
  "title": "Axiom CSS Appearance IR",
  "type": "object",
  "required": [
    "schemaVersion",
    "profile",
    "profileInputDigest",
    "recipeId",
    "slots",
    "base",
    "variantAxes",
    "stateRules",
    "compoundRules",
    "conditionRules"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "profile": { "const": "axiom-css" },
    "profileInputDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "recipeId": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" }
    },
    "base": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/slotDeclarationRecord" }
    },
    "variantAxes": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/variantAxis" }
    },
    "stateRules": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/stateRule" }
    },
    "compoundRules": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/compoundRule" }
    },
    "conditionRules": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/conditionRule" }
    }
  },
  "$defs": {
    "slotDeclarationRecord": {
      "type": "object",
      "required": ["slot", "declarations"],
      "properties": {
        "slot": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "declarations": {
          "$ref": "https://axiom.dev/schemas/css/ordered-declaration-list/0.1"
        }
      },
      "unevaluatedProperties": false
    },
    "variantAxis": {
      "type": "object",
      "required": ["name", "values"],
      "properties": {
        "name": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "defaultValue": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/variantValue" }
        }
      },
      "unevaluatedProperties": false
    },
    "variantValue": {
      "type": "object",
      "required": ["value", "apply"],
      "properties": {
        "value": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "apply": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/slotDeclarationRecord" }
        }
      },
      "unevaluatedProperties": false
    },
    "stateRule": {
      "type": "object",
      "required": ["slot", "state", "cases"],
      "properties": {
        "slot": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "state": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/stateCase" }
        }
      },
      "unevaluatedProperties": false
    },
    "stateCase": {
      "type": "object",
      "required": ["equals", "apply"],
      "properties": {
        "equals": {
          "oneOf": [
            { "type": "boolean" },
            { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" }
          ]
        },
        "apply": {
          "$ref": "https://axiom.dev/schemas/css/ordered-declaration-list/0.1"
        }
      },
      "unevaluatedProperties": false
    },
    "variantSelection": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" }
          }
        ]
      }
    },
    "stateSelection": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" },
        "additionalProperties": {
          "oneOf": [
            { "type": "boolean" },
            { "$ref": "https://axiom.dev/schemas/common/identifier/0.1" }
          ]
        }
      }
    },
    "compoundPredicate": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "variants": { "$ref": "#/$defs/variantSelection" },
        "states": { "$ref": "#/$defs/stateSelection" }
      },
      "unevaluatedProperties": false
    },
    "compoundRule": {
      "type": "object",
      "required": ["when", "apply"],
      "properties": {
        "when": { "$ref": "#/$defs/compoundPredicate" },
        "apply": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/slotDeclarationRecord" }
        }
      },
      "unevaluatedProperties": false
    },
    "conditionRule": {
      "type": "object",
      "required": ["when", "apply"],
      "properties": {
        "when": { "$ref": "https://axiom.dev/schemas/condition/expression/0.1" },
        "variants": { "$ref": "#/$defs/variantSelection" },
        "states": { "$ref": "#/$defs/stateSelection" },
        "apply": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/slotDeclarationRecord" }
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
