{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/css/declaration-value/0.1",
  "title": "Axiom CSS Declaration Value",
  "oneOf": [
    { "$ref": "#/$defs/cssLiteral" },
    { "$ref": "https://axiom.dev/schemas/common/token-reference/0.1" },
    { "$ref": "#/$defs/cssValueTemplate" }
  ],
  "$defs": {
    "cssLiteral": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "css" },
        "value": { "type": "string", "pattern": "\\S" }
      },
      "unevaluatedProperties": false
    },
    "templatePart": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "https://axiom.dev/schemas/common/token-reference/0.1" }
      ]
    },
    "cssValueTemplate": {
      "type": "object",
      "required": ["kind", "parts"],
      "properties": {
        "kind": { "const": "css-template" },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/templatePart" },
          "contains": {
            "$ref": "https://axiom.dev/schemas/common/token-reference/0.1"
          },
          "minContains": 1
        }
      },
      "unevaluatedProperties": false
    }
  }
}
