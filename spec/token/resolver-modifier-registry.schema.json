{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/token/resolver-modifier-registry/0.1",
  "title": "Axiom Resolver Modifier Registry",
  "type": "object",
  "required": ["schemaVersion", "modifiers"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "modifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "required": ["id", "values"],
          "properties": {
            "id": { "const": "theme" },
            "values": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [{ "const": "light" }, { "const": "dark" }],
              "items": false
            }
          },
          "unevaluatedProperties": false
        }
      ],
      "items": false
    }
  },
  "unevaluatedProperties": false
}
