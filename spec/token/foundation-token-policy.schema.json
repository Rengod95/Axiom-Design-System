{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/token/foundation-policy/0.1",
  "title": "Axiom Token Foundation Policy",
  "type": "object",
  "required": [
    "schemaVersion",
    "semanticVocabularyRegistry",
    "colorProfile",
    "commonColors",
    "rootFontSizePx",
    "authoredDimensionUnits",
    "derivedCssUnits",
    "forbiddenPrimitiveSegments",
    "colorScales",
    "spaceScale",
    "aspectRatios",
    "dimensionDomainUnits",
    "typography",
    "contrastPairs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "semanticVocabularyRegistry": {
      "const": "semantic-token-vocabulary"
    },
    "colorProfile": {
      "type": "object",
      "required": [
        "canonicalColorSpace",
        "fallback",
        "gamutMapping",
        "componentPrecision"
      ],
      "properties": {
        "canonicalColorSpace": {
          "const": "oklch"
        },
        "fallback": {
          "const": "hex"
        },
        "gamutMapping": {
          "const": "oklch-chroma-reduction"
        },
        "componentPrecision": {
          "type": "object",
          "required": [
            "lightness",
            "chroma",
            "hue"
          ],
          "properties": {
            "lightness": {
              "const": 6
            },
            "chroma": {
              "const": 6
            },
            "hue": {
              "const": 3
            }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "commonColors": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "required": [
            "name",
            "hex"
          ],
          "properties": {
            "name": {
              "const": "white"
            },
            "hex": {
              "const": "#ffffff"
            }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": [
            "name",
            "hex"
          ],
          "properties": {
            "name": {
              "const": "black"
            },
            "hex": {
              "const": "#000000"
            }
          },
          "unevaluatedProperties": false
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "rootFontSizePx": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "authoredDimensionUnits": {
      "type": "array",
      "const": [
        "px",
        "rem"
      ]
    },
    "derivedCssUnits": {
      "type": "array",
      "const": [
        "em"
      ]
    },
    "forbiddenPrimitiveSegments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://axiom.dev/schemas/common/identifier/0.1"
      }
    },
    "colorScales": {
      "type": "array",
      "const": [
        {
          "palette": "neutral",
          "shades": [
            50,
            100,
            200,
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        },
        {
          "palette": "brand",
          "shades": [
            50,
            100,
            200,
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        },
        {
          "palette": "red",
          "shades": [
            50,
            100,
            200,
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        },
        {
          "palette": "amber",
          "shades": [
            50,
            100,
            200,
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        },
        {
          "palette": "green",
          "shades": [
            50,
            100,
            200,
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        },
        {
          "palette": "cyan",
          "shades": [
            50,
            100,
            200,
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        },
        {
          "palette": "purple",
          "shades": [
            50,
            100,
            200,
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        }
      ]
    },
    "spaceScale": {
      "type": "object",
      "required": [
        "baseUnitPx",
        "steps"
      ],
      "properties": {
        "baseUnitPx": {
          "enum": [
            2,
            4
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/scaleStep"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "aspectRatios": {
      "type": "array",
      "const": [
        {
          "id": "1x1",
          "width": 1,
          "height": 1,
          "provenance": "reference"
        },
        {
          "id": "1000x1618",
          "width": 1000,
          "height": 1618,
          "provenance": "reference"
        },
        {
          "id": "2x3",
          "width": 2,
          "height": 3,
          "provenance": "reference"
        },
        {
          "id": "3x4",
          "width": 3,
          "height": 4,
          "provenance": "reference"
        },
        {
          "id": "4x5",
          "width": 4,
          "height": 5,
          "provenance": "reference"
        },
        {
          "id": "5x4",
          "width": 5,
          "height": 4,
          "provenance": "reference"
        },
        {
          "id": "4x3",
          "width": 4,
          "height": 3,
          "provenance": "reference"
        },
        {
          "id": "3x2",
          "width": 3,
          "height": 2,
          "provenance": "reference"
        },
        {
          "id": "1168x1000",
          "width": 1168,
          "height": 1000,
          "provenance": "axiom-extension"
        },
        {
          "id": "1618x1000",
          "width": 1618,
          "height": 1000,
          "provenance": "reference"
        },
        {
          "id": "16x10",
          "width": 16,
          "height": 10,
          "provenance": "reference"
        },
        {
          "id": "16x9",
          "width": 16,
          "height": 9,
          "provenance": "reference"
        },
        {
          "id": "2x1",
          "width": 2,
          "height": 1,
          "provenance": "reference"
        },
        {
          "id": "5x2",
          "width": 5,
          "height": 2,
          "provenance": "axiom-extension"
        },
        {
          "id": "21x9",
          "width": 21,
          "height": 9,
          "provenance": "reference"
        },
        {
          "id": "3x1",
          "width": 3,
          "height": 1,
          "provenance": "axiom-extension"
        }
      ]
    },
    "dimensionDomainUnits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "px",
            "rem"
          ]
        }
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "bodyBasePx",
        "bodyMinimumPx",
        "fontSizePx",
        "weightVariants",
        "families"
      ],
      "properties": {
        "bodyBasePx": {
          "enum": [
            15,
            16
          ]
        },
        "bodyMinimumPx": {
          "type": "number",
          "minimum": 13
        },
        "fontSizePx": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 13
          }
        },
        "weightVariants": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "families": {
          "type": "array",
          "minItems": 10,
          "items": {
            "$ref": "#/$defs/typographyFamily"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "contrastPairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contrastPair"
      }
    }
  },
  "$defs": {
    "scaleStep": {
      "type": "object",
      "required": [
        "name",
        "valuePx"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "valuePx": {
          "type": "number",
          "minimum": 0
        }
      },
      "unevaluatedProperties": false
    },
    "typographyFamily": {
      "type": "object",
      "required": [
        "path",
        "sizePx"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z0-9][A-Za-z0-9]*)+$"
        },
        "sizePx": {
          "type": "number",
          "minimum": 13
        }
      },
      "unevaluatedProperties": false
    },
    "contrastPair": {
      "type": "object",
      "required": [
        "foreground",
        "background",
        "minimumRatio"
      ],
      "properties": {
        "foreground": {
          "type": "string",
          "pattern": "^color\\.semantic\\."
        },
        "background": {
          "type": "string",
          "pattern": "^color\\.semantic\\."
        },
        "minimumRatio": {
          "type": "number",
          "minimum": 1,
          "maximum": 21
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
