{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/token/context-override/0.1",
  "title": "Axiom Normalized Token Context Override",
  "type": "object",
  "required": ["schemaVersion", "context", "tokens"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "context": { "$ref": "https://axiom.dev/schemas/token/context/0.1" },
    "tokens": {
      "type": "array",
      "items": { "$ref": "https://axiom.dev/schemas/token/normalized-record/0.1" }
    }
  },
  "unevaluatedProperties": false
}
