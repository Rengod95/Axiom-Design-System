{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/spec/manifest/0.1",
  "title": "Axiom Specification Manifest",
  "type": "object",
  "required": ["schemaVersion", "dialect", "schemas", "registries", "fixtureSuites"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "dialect": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schemas": {
      "type": "array",
      "items": { "$ref": "#/$defs/schemaEntry" }
    },
    "registries": {
      "type": "array",
      "items": { "$ref": "#/$defs/registryEntry" }
    },
    "fixtureSuites": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixtureSuite" }
    }
  },
  "$defs": {
    "relativeJsonPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "schemaEntry": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^https://axiom\\.dev/schemas/" },
        "path": { "$ref": "#/$defs/relativeJsonPath" }
      },
      "unevaluatedProperties": false
    },
    "registryEntry": {
      "type": "object",
      "required": ["id", "path", "schema"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "path": { "$ref": "#/$defs/relativeJsonPath" },
        "schema": { "type": "string", "pattern": "^https://axiom\\.dev/schemas/" },
        "semanticValidator": {
          "enum": [
            "canonical-state-registry",
            "behavior-criteria-source-manifest",
            "component-behavior-criteria-profile",
            "condition-expression",
            "condition-registry",
            "css-appearance-ir",
            "css-collision-trace",
            "motion-ir",
            "token-domain-registry",
            "token-identity",
            "parsed-token-document",
            "resolved-token-manifest",
            "semantic-token-vocabulary",
            "token-context-override"
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "fixtureSuite": {
      "type": "object",
      "required": ["id", "schema", "positiveDirectory", "negativeDirectory"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "schema": { "type": "string", "pattern": "^https://axiom\\.dev/schemas/" },
        "positiveDirectory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "negativeDirectory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "semanticValidator": {
          "enum": [
            "canonical-state-registry",
            "behavior-criteria-source-manifest",
            "component-behavior-criteria-profile",
            "condition-expression",
            "condition-registry",
            "css-appearance-ir",
            "css-collision-trace",
            "motion-ir",
            "token-domain-registry",
            "token-identity",
            "parsed-token-document",
            "resolved-token-manifest",
            "semantic-token-vocabulary",
            "token-context-override"
          ]
        },
        "allowedWarnings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" }
        },
        "relatedFixtures": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/relatedFixture" }
        }
      },
      "unevaluatedProperties": false
    },
    "relatedFixture": {
      "type": "object",
      "required": ["path", "schema"],
      "properties": {
        "path": { "$ref": "#/$defs/relativeJsonPath" },
        "schema": { "type": "string", "pattern": "^https://axiom\\.dev/schemas/" },
        "semanticValidator": {
          "enum": [
            "canonical-state-registry",
            "behavior-criteria-source-manifest",
            "component-behavior-criteria-profile",
            "condition-expression",
            "condition-registry",
            "css-appearance-ir",
            "css-collision-trace",
            "motion-ir",
            "token-domain-registry",
            "token-identity",
            "parsed-token-document",
            "resolved-token-manifest",
            "semantic-token-vocabulary",
            "token-context-override"
          ]
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
