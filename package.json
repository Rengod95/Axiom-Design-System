{
  "name": "axiom-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:standards && pnpm check:boundaries && tsc -b --pretty false && pnpm contracts:type-check && pnpm recipe:type-check && pnpm tokens:check && pnpm profile:check && pnpm spec:check && pnpm contracts:check",
    "check:standards": "node scripts/check-source-standards.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "contracts:check": "pnpm --filter @axiom/spec-tooling contracts:check",
    "contracts:generate": "pnpm --filter @axiom/spec-tooling contracts:generate",
    "contracts:type-check": "pnpm --filter @axiom/condition-registry type-check && pnpm --filter @axiom/motion-schema type-check && pnpm --filter @axiom/behavior-contracts type-check",
    "recipe:type-check": "pnpm --filter @axiom/recipe-kernel check:types && pnpm --filter @axiom/appearance-authoring type-check",
    "clean": "tsc -b --clean",
    "profile:check": "node --import tsx packages/css-property-profile/src/cli.ts",
    "profile:generate": "node --import tsx packages/css-property-profile/src/cli.ts --write",
    "spec:check": "node --import tsx packages/spec-tooling/src/cli.ts",
    "test": "vitest run",
    "tokens:check": "node --import tsx packages/token-tooling/src/generate-foundation-artifacts.ts",
    "tokens:generate": "node --import tsx packages/token-tooling/src/generate-foundation-artifacts.ts --write",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
