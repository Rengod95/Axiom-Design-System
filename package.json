{
  "name": "@axiom/document-kernel-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "check": "node scripts/generate-ads-validator.mjs --check && tsc --noEmit && node scripts/check-implementation.mjs",
    "generate": "node scripts/generate-ads-validator.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/build-studio.mjs",
    "test": "node scripts/run-tests.mjs",
    "axiom": "node apps/cli/src/main.ts",
    "test:browser": "node scripts/verify-browser-store.mjs",
    "studio": "node scripts/build-studio.mjs && node scripts/serve-studio.mjs",
    "delivery": "node apps/delivery/src/main.ts",
    "test:studio": "node scripts/verify-studio.mjs",
    "test:targets": "node scripts/verify-targets.mjs",
    "test:workbench": "node scripts/verify-workbench.mjs",
    "test:references": "node scripts/verify-reference-studio.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@sun-typeface/suit": "2.0.5",
    "geist": "1.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
