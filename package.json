{
  "name": "axiom-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm check:standards && pnpm check:boundaries && pnpm spec:check && tsc -b --pretty false",
    "check:standards": "node scripts/check-source-standards.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "clean": "tsc -b --clean",
    "spec:check": "node --import tsx packages/spec-tooling/src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
